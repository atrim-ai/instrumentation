{
  "name": "@atrim/instrumentation-example-remote-config",
  "version": "1.0.0",
  "description": "Remote configuration example for @atrim/instrumentation",
  "type": "module",
  "private": true,
  "scripts": {
    "config-server": "tsx config-server/index.ts",
    "app": "tsx index.ts",
    "start": "concurrently \"npm run config-server\" \"sleep 2 && npm run app\"",
    "dev": "tsx watch index.ts"
  },
  "dependencies": {
    "@atrim/instrumentation": "file:../..",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "@opentelemetry/sdk-trace-base": "^1.25.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "concurrently": "^8.2.2"
  }
}
