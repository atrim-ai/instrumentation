{
  "name": "@atrim/instrumentation-example-remote-config",
  "version": "0.5.1",
  "description": "Remote configuration example for @atrim/instrumentation",
  "type": "module",
  "private": true,
  "scripts": {
    "config-server": "tsx config-server/index.ts",
    "app": "tsx index.ts",
    "start": "concurrently \"npm run config-server\" \"sleep 2 && npm run app\"",
    "dev": "tsx watch index.ts"
  },
  "dependencies": {
    "@atrim/instrument-node": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2"
  }
}
