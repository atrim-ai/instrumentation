{
  "name": "@atrim/instrumentation-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Universal OpenTelemetry instrumentation for multiple runtimes (Node.js, Web, Python)",
  "type": "module",
  "license": "MIT",
  "author": "Atrim AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/atrim-ai/instrumentation.git"
  },
  "bugs": {
    "url": "https://github.com/atrim-ai/instrumentation/issues"
  },
  "homepage": "https://github.com/atrim-ai/instrumentation#readme",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "clean": "turbo run clean && rm -rf node_modules packages/*/node_modules",
    "registry:start": "docker compose up -d",
    "registry:stop": "docker compose down",
    "registry:logs": "docker compose logs -f verdaccio",
    "publish:local": "turbo run publish:local",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.1.1",
    "turbo": "^2.6.1",
    "typescript": "^5.7.2"
  }
}
