{
  "name": "@atrim/instrumentation",
  "version": "0.1.0",
  "description": "Universal OpenTelemetry instrumentation with centralized YAML configuration. Works with any Node.js application.",
  "type": "module",
  "license": "MIT",
  "author": "Atrim AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/atrim-ai/instrumentation.git"
  },
  "keywords": [
    "opentelemetry",
    "instrumentation",
    "tracing",
    "observability",
    "nodejs",
    "bun",
    "deno",
    "effect",
    "express",
    "fastify"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./effect": {
      "types": "./dist/integrations/effect/index.d.ts",
      "import": "./dist/integrations/effect/index.js",
      "require": "./dist/integrations/effect/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "config",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "pnpm run build && pnpm run test && pnpm run typecheck"
  },
  "dependencies": {
    "yaml": "^2.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.28.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.7.2",
    "vitest": "^1.0.4"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "@opentelemetry/sdk-trace-base": "^1.0.0",
    "@opentelemetry/sdk-trace-node": "^1.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.50.0",
    "effect": "^3.0.0",
    "@effect/opentelemetry": ">=0.40.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": false
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "@effect/opentelemetry": {
      "optional": true
    }
  }
}
