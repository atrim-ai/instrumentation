{
  "name": "@atrim/instrumentation-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @atrim/instrument-* packages",
  "type": "module",
  "license": "MIT",
  "author": "Atrim AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/atrim-ai/instrumentation.git"
  },
  "bugs": {
    "url": "https://github.com/atrim-ai/instrumentation/issues"
  },
  "homepage": "https://github.com/atrim-ai/instrumentation#readme",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:all": "turbo run test:all",
    "cleanup:containers": "docker ps -a --filter 'ancestor=otel/opentelemetry-collector:latest' -q | xargs -r docker rm -f",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"packages/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"examples/**/*.ts\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "publish:dev": "pnpm build && bash scripts/publish-snapshot.sh $npm_config_otp",
    "publish:dev:node": "pnpm --filter @atrim/instrument-node publish:dev",
    "publish:dev:web": "pnpm --filter @atrim/instrument-web publish:dev"
  },
  "pnpm": {
    "overrides": {
      "effect": "npm:@clayroach/effect@3.19.14-source-capture.8",
      "@effect/platform": "^0.93.6",
      "@effect/platform-node": "^0.103.0",
      "@effect/opentelemetry": "^0.59.1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@effect/cluster",
        "@effect/rpc",
        "@effect/sql"
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.39.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-trace-base": "^1.28.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@types/express": "^5.0.5",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.2",
    "express": "^5.1.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.17",
    "typescript": "^5.7.2"
  }
}
