{
  "name": "@atrim/instrument-core",
  "version": "0.4.0",
  "description": "Core instrumentation logic shared across platform packages",
  "type": "module",
  "license": "MIT",
  "author": "Atrim AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/atrim-ai/instrumentation.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/atrim-ai/instrumentation/issues"
  },
  "homepage": "https://github.com/atrim-ai/instrumentation#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opentelemetry",
    "instrumentation",
    "tracing",
    "observability",
    "effect",
    "effect-platform"
  ],
  "exports": {
    ".": {
      "types": "./target/dist/index.d.ts",
      "import": "./target/dist/index.js",
      "require": "./target/dist/index.cjs"
    }
  },
  "main": "./target/dist/index.cjs",
  "module": "./target/dist/index.js",
  "types": "./target/dist/index.d.ts",
  "files": [
    "target/dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo 'No tests for core package'",
    "test:watch": "echo 'No tests for core package'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf target",
    "publish:dev:version": "npm version $(git describe --tags --abbrev=0 | sed 's/^.*@//' | sed 's/^v//')-$(git rev-parse --short HEAD)-$(date -u +%Y%m%d%H%M%S) --no-git-tag-version",
    "publish:dev:save": "node -p \"require('./package.json').version\" > .version",
    "publish:dev:publish": "pnpm build && npm publish --tag dev --access public",
    "publish:dev:reset": "npm version 0.4.0 --no-git-tag-version",
    "publish:dev": "pnpm publish:dev:version && pnpm publish:dev:save && pnpm publish:dev:publish && pnpm publish:dev:reset"
  },
  "dependencies": {
    "effect": "^3.19.0",
    "@effect/platform": "^0.93.0",
    "yaml": "^2.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.7.2",
    "tsup": "^8.0.1"
  }
}
